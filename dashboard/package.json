{
  "name": "reps-dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write \"src/**/*.{ts,svelte,html,css,json}\"",
    "lint": "eslint \"src/**/*.{ts,svelte}\"",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.63.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^2.46.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "prettier": "^3.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tanstack/svelte-query": "^6.2.4",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "svelte": "^5.57.1",
    "zod": "^4.6.5"
  }
}
